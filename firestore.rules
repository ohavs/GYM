rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// Every document lives under users/{uid}. A signed-in account can read and
// write only its own subtree, and nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /trainees/{traineeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
